# Copy this file to .env.local and fill in your Google OAuth Client ID
# Create a project at https://console.cloud.google.com/
# Enable the Gmail API, configure OAuth consent screen, create OAuth 2.0 credentials
# Add http://localhost:5173 to Authorized JavaScript origins

VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
